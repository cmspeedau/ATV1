#!/bin/sh
# atv1 initramfs /init — early beacon + root resolution + handover.
#
# Used ONLY by the restore-layout boot path (boot.efi -> mach_kernel with
# this cpio embedded). The kernel cmdline arrives via com.apple.Boot.plist
# "Kernel Flags": root=LABEL=ATV1ROOT rootwait console=ttyS0,57600
#
# WHY AN INITRAMFS: (1) the kernel cannot resolve root=LABEL= itself and
# device letters shift between USB-stick boot (stick lands on sdb behind
# the internal sda) and internal-disk boot (root is sda); (2) STAGE
# TELEMETRY: this init shouts on the LAN before touching any disk, so a
# gratuitous-ARP sighting of the unit's MAC proves "kernel + NIC + DHCP
# alive" even if the root handover then fails. No sighting at all = the
# boot died before initramfs (loader/kernel problem), not a config
# problem. The rootfs beacon (S60beacon) takes the shout over after
# switch_root; both never give up.
#
# /dev is devtmpfs, already mounted by the kernel (DEVTMPFS_MOUNT=y).
PATH=/bin:/sbin
mkdir -p /proc /sys
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null

# ---- console capture to the stick (works with ZERO network) ----
# Dump the kernel ring buffer + device-world inventory onto the atvrecv
# FAT partition (label ATVRECV) so a unit with no working HDMI/serial/NIC
# still leaves a readable log for whoever plugs the stick into a Mac.
# Called at init start AND every 10 s during the root hunt: whenever the
# stick's USB enumeration finally lands, the very next dump sticks.
save_console() {
	D=""
	for d in /dev/sd?? /dev/hd??; do
		[ -b "$d" ] || continue
		L=$(blkid -o value -s LABEL "$d" 2>/dev/null)
		[ "$L" = "ATVRECV" ] && DEV_F="$d" && break
	done
	[ -n "${DEV_F:-}" ] || return 0
	mkdir -p /boot1
	mount -t vfat "$DEV_F" /boot1 2>/dev/null || return 0
	{
		U="?"
		read UP _ < /proc/uptime 2>/dev/null && U="${UP%%.*}"
		echo "=== atv1 initramfs console dump (up=${U}s) ==="
		dmesg
		echo "--- /proc/partitions ---"; cat /proc/partitions
		echo "--- /sys/block ---";      ls /sys/block 2>/dev/null
		echo "--- /sys/class/net ---";  ls /sys/class/net 2>/dev/null
	} > /boot1/atv1-kmsg.txt 2>/dev/null
	sync
}

# hard reboot via sysrq: LOUD failure signal. A reboot cycle ~35-40 s
# after power-on now means "init ran, root hunt failed" — forever-frozen
# means hung BEFORE init. This is the discriminator the silent
# `exec sh` fallback could never be.
scream_reboot() {
	save_console
	echo "ATV1 INIT FAILED ROOT HUNT -> sysrq reboot" > /dev/kmsg
	echo 1 > /proc/sys/kernel/sysrq 2>/dev/null
	echo b > /proc/sysrq-trigger   2>/dev/null
	exec sh   # if sysrq somehow off: serial shell remains the last resort
}

# ---- background early beacon (never blocks the root hunt) ----
(
	IP=""
	# eth0 appears when ioreg probes PCI (8139too built-in); give it 15 s
	j=0
	while [ "$j" -lt 15 ]; do
		ifconfig eth0 >/dev/null 2>&1 && break
		sleep 1
		j=$((j + 1))
	done
	if ifconfig eth0 >/dev/null 2>&1; then
		# BusyBox udhcpc delivers leases to its -s event script via env
		# (interface/ip/subnet/router); stdout carries NOTHING we can
		# rely on, and this cpio has no default.script — configure via
		# the packed hook, then read the result back. Token parsing only:
		# this busybox has NO awk/cut applets (verified from the binary
		# — an applet-name grep would have silently returned empty).
		udhcpc -n -q -t 10 -T 2 -i eth0 -s /bin/udhcpc.script >/dev/null 2>&1
		IP=""
		for t in $(ifconfig eth0 2>/dev/null); do
			case "$t" in addr:*) IP="${t#addr:}" ;; esac
		done
	fi
	if [ -n "$IP" ]; then
		MAC=""
		PHN=0
		for t in $(ifconfig eth0); do
			if [ "$PHN" = 1 ]; then MAC="$t"; break; fi
			[ "$t" = "HWaddr" ] && PHN=1
		done
		echo "ATV1 INITRAMFS-OK ip=$IP mac=$MAC" > /dev/kmsg
		while :; do
			arping -A -c 1 "$IP" >/dev/null 2>&1
			ping -c 1 -b "${IP%.*}.255" >/dev/null 2>&1
			sleep 60
		done
	fi
	# no lease: say so once on serial; the root hunt below still runs
	echo "ATV1 initramfs: NO DHCP on eth0 (link? cable?)" > /dev/kmsg
) >/dev/null 2>&1 &

# ---- root resolution ----
ROOT=""
for a in $(cat /proc/cmdline); do
	case "$a" in
		root=*) ROOT="${a#root=}" ;;
	esac
done
[ -n "$ROOT" ] || ROOT="LABEL=ATV1ROOT"

DEV=""
LABEL=""
case "$ROOT" in
	LABEL=*) LABEL="${ROOT#LABEL=}" ;;
	/dev/*)  DEV="$ROOT" ;;
esac

mkdir -p /mnt

# Scream-and-record boot: first dump the moment init exists (stick USB
# enumeration ~5-20 s, so the start-of-day dump usually lands blind, but
# the periodic ones below catch every later appearance).
save_console

# rootwait behaviour: poll up to 30 s, dumping the console + device
# inventory every 10 s (log grows = init alive at that timestamp).
i=0
while [ "$i" -lt 30 ]; do
	if [ -n "$LABEL" ]; then
		for d in /dev/sd* /dev/hd*; do
			[ -b "$d" ] || continue
			L=$(blkid -o value -s LABEL "$d" 2>/dev/null)
			[ "$L" = "$LABEL" ] && DEV="$d" && break
		done
	fi
	[ -n "$DEV" ] && [ -b "$DEV" ] && break
	if [ $((i % 10)) -eq 9 ]; then save_console; fi
	i=$((i + 1))
	sleep 1
done

if [ -z "$DEV" ] || [ ! -b "$DEV" ]; then
	echo "atv1-init: FATAL no block device for root=$ROOT after 30s"
	ls -l /dev/sd* /dev/hd* 2>/dev/null
	scream_reboot
fi

echo "atv1-init: mounting $DEV ($ROOT)"
mount -o rw "$DEV" /mnt || mount -o ro "$DEV" /mnt || {
	echo "atv1-init: FATAL cannot mount $DEV"
	scream_reboot
}

# switch_root needs /dev/console in the new root; the buildroot static
# /dev provides it, but guarantee it (harmless if present).
[ -c /mnt/dev/console ] || mknod /mnt/dev/console c 5 1 2>/dev/null

echo "ATV1 initramfs: handover to switch_root" > /dev/kmsg
save_console
exec switch_root /mnt /sbin/init
