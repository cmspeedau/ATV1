# ============================================================
# ATV1 kernel fragment — merged AUTOMATICALLY by Buildroot on
# every configure, via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES
# (README §4). Syntax: disable = canonical
# "# CONFIG_X is not set"; a "# CONFIG_X=n" comment disables
# NOTHING (proven); future items live as prose, never as
# comment-styled settings.
# ============================================================

# ---- Optional hardware: Broadcom BCM70012 CrystalHD (NOT INSTALLED) ----
# Verified against the kernel repos (raw fetches, 2026-10-27): the
# driver is in-tree through Linux 3.16 — the FINAL stable 3.16.85
# still carries CONFIG_CRYSTALHD (plain "depends on PCI", no BROKEN
# gate) — and was deleted in 3.17. The box has no card today; if the
# owner's mini-PCIe card arrives, the plan is a kernel flip to 3.16.85
# (the last config with the driver in tree, the one the 2009-2013 mods
# actually ran): headers -> 3.16, re-add CONFIG_STAGING=y +
# CONFIG_CRYSTALHD=y here, enable package/crystalhd (mirror alive,
# hash recorded). A backport of crystalhd-arch's dkms port (targets
# 4.19+) to 4.9 is the fallback if the 3.16 flip ever proves
# unworkable. BUYING CONSTRAINT (verified from the driver's own PCI id
# table at v3.16.85): it binds exactly ONE device — 14e4:1612, i.e. the
# BCM70012 card (card label BCM970012, the dual-chip board). The newer
# BCM70015 cards (card labels BCM970015 / Samsung AW-VD920) are NOT
# in-tree — they must not be bought for this project. lspci check for
# the real card: 0x14e4:0x1612. Until a card is in: software decode,
# no staging.

# ---- GPU: BOTH, because the fleet is heterogeneous (ioreg-proven) ----
# Unit A (stock .46): Intel GMA950 only. Unit B (mod .8): mini-PCIe
# GeForce Go 7300 (10de:01d7, Apple subsystem) behind a PCIe bridge,
# owning that unit's HDMI. Both DRM drivers built-in; per-unit screen
# choice is an xstartup concern (README TODO), not a kernel one.
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_TTM=y
# History, since this file flip-flopped: an early draft disabled i915
# "because the 7300 owns HDMI" (true of unit B, false of A); a later
# draft purged nouveau "because Mac1,1 has no NVIDIA" (true of unit A,
# false of B). Evidence from both units' ioreg ended the argument.
CONFIG_X86_PAT=y

# ---- Boot / console ----
CONFIG_EFI=y
CONFIG_EFI_MIXED=y
CONFIG_BINFMT_ELF=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- Storage: internal 2.5" SATA (ICH7: IDE-emulated or AHCI) + USB ----
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# a modest 2007 EHCI host — keep quirks off, it prefers patient devices

# ---- Root filesystems ----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# ---- Network: PROVEN on unit B (ioreg): Realtek RTL8139 (10ec:8139) ----
# None of the five "likely 2007" candidates below matches that chip —
# 8139too is the driver. Candidates stay as cheap insurance until unit
# A's NIC is eyeballed (same product line, so expect the same 8139).
CONFIG_NET_ETHERNET=y
CONFIG_8139TOO=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL2=y

# ---- Audio: ICH7 HD-Audio (HDMI + optical out) ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_CODEC_REALTEK=y

# ---- Input: USB keyboard for bring-up ----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_USB_HID=y

# ---- Power/thermals: this box is fanless-to-near-silent, keep it cool ----
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_IDLE=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_THERMAL=y

# ---- Future/roadmap (NOT enabled — prose until a real decision) ----
# A squashfs+overlay rootfs and zram pass would add: SQUASHFS,
# SQUASHFS_LZ4, OVERLAY_FS, ZRAM. Written as prose on purpose —
# "# CONFIG_X=y"-style comment lines are ambiguous to config
# mergers and must not sit in a fragment pretending to be disabled.

# ---- Era-compiler reality ----
# CONFIG_RETPOLINE is not set
# LOAD-BEARING: 4.9.337 carries the backported Spectre-RSB retpoline
# machinery, whose archprepare check hard-fails on era gcc 6.3 (it
# needs -mfunction-return=thunk, gcc >= 7). The mitigation is OFF by
# era pin, named here, and verified off in the merged .config — never
# silently dropped.
