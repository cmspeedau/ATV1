# ============================================================
# ATV1 kernel fragment — merged AUTOMATICALLY by Buildroot on
# every configure, via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES
# (README §4). Syntax: disable = canonical
# "# CONFIG_X is not set"; a "# CONFIG_X=n" comment disables
# NOTHING (proven); future items live as prose, never as
# comment-styled settings.
# ============================================================

# ---- Optional hardware: Broadcom BCM70012 CrystalHD (NOT INSTALLED) ----
# The owner's A1218 has no CrystalHD card; historically it was an
# add-on mini-PCIe mod, never onboard. The in-tree staging driver is
# gone from every kernel reachable here (verified absent: 4.9.337,
# 4.11.12, 4.12.14, 4.13.16, 4.14.335). If a card is ever installed,
# the driver comes from LibreELEC's out-of-tree module — do not chase
# an in-tree kernel and do not re-add CONFIG_CRYSTALHD here.

# ---- GPU: Intel GMA950 (i945GMS) — the A1218's ONLY GPU ----
CONFIG_DRM=y
CONFIG_DRM_I915=y
# CONFIG_DRM_NOUVEAU is not set
# Old claim purged 2026-10-27: "GeForce Go 7300 owns the HDMI port,
# never enable i915" — Mac1,1 has no NVIDIA silicon; that line would
# have disabled the driver for the only GPU and given a black screen.
# HDMI comes out via an SDVO bridge; 2007 Apple SDVO hotplug quirks
# are a named Stage-0 observation (verify with lspci/dmesg on hardware).
CONFIG_X86_PAT=y

# ---- Boot / console ----
CONFIG_EFI=y
CONFIG_EFI_MIXED=y
CONFIG_BINFMT_ELF=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- Storage: internal 2.5" SATA (ICH7: IDE-emulated or AHCI) + USB ----
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# a modest 2007 EHCI host — keep quirks off, it prefers patient devices

# ---- Root filesystems ----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# ---- Network: Apple's 945-era NIC is one of these; cheap insurance ----
CONFIG_NET_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL2=y

# ---- Audio: ICH7 HD-Audio (HDMI + optical out) ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_CODEC_REALTEK=y

# ---- Input: USB keyboard for bring-up ----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_USB_HID=y

# ---- Power/thermals: this box is fanless-to-near-silent, keep it cool ----
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_IDLE=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_THERMAL=y

# ---- Future/roadmap (NOT enabled — prose until a real decision) ----
# A squashfs+overlay rootfs and zram pass would add: SQUASHFS,
# SQUASHFS_LZ4, OVERLAY_FS, ZRAM. Written as prose on purpose —
# "# CONFIG_X=y"-style comment lines are ambiguous to config
# mergers and must not sit in a fragment pretending to be disabled.

# ---- Era-compiler reality ----
# CONFIG_RETPOLINE is not set
# LOAD-BEARING: 4.9.337 carries the backported Spectre-RSB retpoline
# machinery, whose archprepare check hard-fails on era gcc 6.3 (it
# needs -mfunction-return=thunk, gcc >= 7). The mitigation is OFF by
# era pin, named here, and verified off in the merged .config — never
# silently dropped.
