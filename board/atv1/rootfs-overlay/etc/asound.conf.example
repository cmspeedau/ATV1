# ALSA default for the ATV1: ICH7 HD-audio, HDMI on card 0.
# startkodi.sh copies this to /etc/asound.conf on first boot.
# If HDMI audio is silent/flickery on this vintage, flip default to
# the S/PDIF device (check `aplay -l` over serial/dropbear), e.g.:
#
#   pcm.!default {
#       type hw
#       card 0
#       device 1        # <- S/PDIF optical, device 0 is HDMI
#   }
#
pcm.!default {
    type hw
    card 0
    device 0
}

ctl.!default {
    type hw
    card 0
}
