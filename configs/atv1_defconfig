# ============================================================
# ATV1 — Apple TV 1st gen (A1218) Kodi appliance
# Target era: Buildroot 2017.08 (see README — build in era)
# Minimal fragment: only lines that differ from defaults.
# ============================================================

# ---- Target: 32-bit, Crofton Pentium M ----
BR2_i386=y
# The actual variant. i586 (the default) has no SSE and hides Kodi;
# pentium_m selects MMX+SSE — claiming no SSE2 or beyond, since
# Crofton's exact ISA level is not verified on hardware. If Stage-0
# CPUID shows SSE2 we may raise to pentium4; not before.
BR2_x86_pentium_m=y
# The 2017.08-era prompt is BR2_TOOLCHAIN_BUILDROOT_CXX; it selects the
# promptless BR2_INSTALL_LIBSTDCPP. Assigning the latter directly is
# silently dropped by kconfig — this exact mistake hid Kodi/Mesa/Xorg
# from the first defconfig run.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# glibc, not uClibc: the Rust appliance client targets
# i586-unknown-linux-gnu — a gnu triple.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# ---- System ----
BR2_TARGET_GENERIC_HOSTNAME="atv1"
BR2_TARGET_GENERIC_ISSUE="ATV1 Kodi appliance"
# Plain root password, noted in README §5 + ATV1-SPECS on purpose: a
# LAN kiosk people should be able to use (anyone, not only key-holders).
# 'frontrow' follows the NitoTV-era convention the modded units already
# carry — one credential story across the fleet. Resets with every
# reflash; the ed25519 fleet key in the overlay is the admin identity.
# (kconfig auto-selects host-mkpasswd here; era md5 method — dropbear
# speaks md5crypt. Audit the generated .config after defconfig runs.)
BR2_TARGET_GENERIC_ROOT_PASSWD="frontrow"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/post-image.sh"

# ---- Kernel: 4.9.x LTS — the era's own LTS of record ----
# CrystalHD no longer drives this choice, because the box has NO
# BCM70012 card (owner-confirmed) — and the in-tree staging driver is
# gone from every kernel reachable here anyway, verified by tarball
# listing: absent from 4.9.337 (stable backported the removal),
# 4.11.12, 4.12.14, 4.13.16 and 4.14.335. 4.9 is Buildroot 2017.08's
# LTS: old enough for era gcc, new enough for i915 KMS + EFI + SDVO.
# A card added later gets its driver from the verified in-tree source
# — the kernel flips to 3.16.85, the last release carrying it (see the
# card plan in board/atv1/linux.fragment). Not today: no card.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="4.9.337"
# Headers pinned to the same LTS. (The 4.12 choice existed only to
# satisfy the consistency check of the abandoned 4.14 attempt.)
BR2_KERNEL_HEADERS_4_9=y
# x86 i386 defconfig + this board's fragment (i915, fb, NIC
# candidates). The fragment re-applies on every defconfig run —
# no menuconfig capture step needed (README §4).
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="i386"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/linux.fragment"

# ---- Graphics: a heterogeneous fleet, proven by ioreg on the units ----
# Unit A (stock, .46): Intel GMA950 (i945GMS) only -> i915 + swrast GL.
# Unit B (aTVFlash/NitoTV mod, .8): mini-PCIe GeForce Go 7300 (PCI
# 10de:01d7, Apple subsystem) behind a PCIe bridge — it owns that box's
# HDMI. nv40 gets real hardware GL via Mesa 17.1's NOUVEAU classic DRI
# — a reason the Mesa era pin matters. X's default probe prefers the
# iGPU on unit B, so its xstartup must force the nouveau screen (TODO
# GPU-select logic before unit B runs this image).
# 2017.08-era X11 umbrella symbol (BR2_PACKAGE_XORG_SERVER is a later
# naming; kconfig silently drops assignments to unknown symbols).
BR2_PACKAGE_XORG7=y
# xinit and the driver menu hang off the server symbol in this layout.
BR2_PACKAGE_XSERVER_XORG_SERVER=y
# Intel DDX: the era-correct X driver for GMA950 on KMS (this era has
# no modesetting driver package).
BR2_PACKAGE_XDRIVER_XF86_VIDEO_INTEL=y
# Nouveau DDX: unit B's Go 7300 (and its HDMI).
BR2_PACKAGE_XDRIVER_XF86_VIDEO_NOUVEAU=y
# fbdev stays as the Stage-0 fallback (SDVO quirks on A, safety net on B).
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_MESA3D=y
# Kodi's visibility needs HAS_LIBEGL (+LIBGL): Mesa's EGL/GLES APIs are
# explicit options in this era; whether Kodi's runtime prefers GLX or
# EGL is a Stage-1 observation, but the build gate needs these flags.
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Unit B's nv40 via Mesa 17.1's NOUVEAU classic DRI (there is no _NV40
# symbol; nv40 support is gone from Mesa >= 17.3 — the era pin again).
BR2_PACKAGE_MESA3D_DRI_DRIVER_NOUVEAU=y
# Unit A's GMA950: software GL, named not smuggled. Mesa 17.1 DELETED
# the classic i915 driver (_DRI_DRIVER_I915 option is stale); i915g
# gallium and llvm/llvmpipe are not exposed by this buildroot. Gallium
# swrast = GL 2.1 software, exactly Kodi 17's floor. Whether 1 GHz +
# 256 MB drives it acceptably is a Stage-0 observation, not a claim.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y

# ---- Media: Kodi 17 (last release with CrystalHD support — see note) ----
# Kodi is visible only once python2 carries .py modules (its own gate
# comment): BR2_PACKAGE_PYTHON is this era's python2 symbol, and the
# era default installs .pyc ONLY — which the gate rejects, so the
# .py+.pyc choice is explicit. Kodi 17 bundles its Python runtime in
# core; this era has no separate BR2_PACKAGE_KODI_PYTHON symbol.
BR2_PACKAGE_PYTHON=y
BR2_PACKAGE_PYTHON_PY_PYC=y
BR2_PACKAGE_KODI=y
# skin.atv's typeface (Bitstream Vera license — redistributable, no
# Apple assets anywhere in the skin). post-build.sh copies
# DejaVuSans.ttf + DejaVuSans-Bold.ttf from here into the skin's
# fonts/ dir; the skin's Font.xml references exactly those names.
BR2_PACKAGE_DEJAVU=y
# BR2_PACKAGE_CRYSTALHD stays OFF: the box has no BCM70012 card, so
# software decode is the honest envelope (SD / easy 720p). The package
# is dormant but alive: mirror repointed to crystalhd-arch (verified
# tarball, sha512 recorded in .hash). Card path when one arrives: flip
# the kernel to 3.16.85 per linux.fragment, enable here, wire
# KODI_DEPENDENCIES (see crystalhd.mk). Era pin stays justified: 18
# removed CrystalHD support entirely.

# ---- Utilities ----
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_HTOP=y
# mount.cifs helper for CONFIG_CIFS=y (OS-level SMB client, README §6a)
BR2_PACKAGE_CIFS_UTILS=y
# target-side disk surgery: grow the data partition at install, GPT work for
# the stock boot-chain path once observed on hardware (ARCHITECTURE doc §4)
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y

# ---- Host tools genimage 9 shells out to (learned at 03:00 by absence) ----
# vfat images: mkdosfs from dosfstools; file injection: mcopy/mmd from mtools;
# ext content images: genext2fs; ext labels: tune2fs (e2fsprogs). All four
# are execl'd by genimage 9's own source; era genimage.mk declares none of
# them. NOTE genext2fs has no HOST_-only symbol this era — enabling it
# selects target+host, so the binary also lands on the appliance (fine:
# 40 KB, and it's legitimate disk-surgery kit alongside resize2fs).
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_GENEXT2FS=y

# ---- Appliance client (ARCHITECTURE doc): Rust, built out-of-era against
# the Buildroot SDK — see tools/build-client.sh. Default-off until the
# binary exists; when it does, it takes over the tty1 kiosk slot. ----
# BR2_PACKAGE_ATV1_CLIENT=y

# ---- Bootloader: GRUB ia32 EFI (ATV1 firmware is 32-bit EFI) ----
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_EFI=y
# config embedded into grub image: board/grub-i386-efi.cfg

# ---- Rootfs & disk image ----
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_PACKAGE_HOST_GENIMAGE=y
