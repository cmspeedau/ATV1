# ============================================================
# ATV1 — Apple TV 1st gen (A1218) Kodi appliance
# Target era: Buildroot 2017.08 (see README — build in era)
# Minimal fragment: only lines that differ from defaults.
# ============================================================

# ---- Target: 32-bit, Crofton Pentium M ----
BR2_i386=y
# The actual variant. i586 (the default) has no SSE and hides Kodi;
# pentium_m selects MMX+SSE — claiming no SSE2 or beyond, since
# Crofton's exact ISA level is not verified on hardware. If Stage-0
# CPUID shows SSE2 we may raise to pentium4; not before.
BR2_x86_pentium_m=y
# The 2017.08-era prompt is BR2_TOOLCHAIN_BUILDROOT_CXX; it selects the
# promptless BR2_INSTALL_LIBSTDCPP. Assigning the latter directly is
# silently dropped by kconfig — this exact mistake hid Kodi/Mesa/Xorg
# from the first defconfig run.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# glibc, not uClibc: crystalhd userspace depends on it, and the Rust
# appliance client targets i586-unknown-linux-gnu.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# ---- System ----
BR2_TARGET_GENERIC_HOSTNAME="atv1"
BR2_TARGET_GENERIC_ISSUE="ATV1 Kodi appliance"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/post-image.sh"

# ---- Kernel: 4.14.x — last LTS with staging/crystalhd ----
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="4.14.335"
# Toolchain headers stay at the release's 4.12 (its choice list tops
# out there): "same as kernel" (the default when a kernel is built)
# trips this era's consistency check — expected 4.12.x, got 4.14.x.
# glibc capped at 4.12 UAPI under a 4.14 kernel is the normal
# old-userland/new-kernel pairing; CrystalHD is a kernel-side symbol
# and unaffected.
BR2_KERNEL_HEADERS_4_12=y
# x86 i386 defconfig + this board's fragment (crystalhd staging, fb,
# NIC candidates). The fragment re-applies on every defconfig run —
# no menuconfig capture step needed (README §4).
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="i386"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ATV1_PATH)/board/atv1/linux.fragment"

# ---- Graphics: Go 7300 via nouveau (NOT the 945GM's GMA950) ----
# 2017.08-era X11 umbrella symbol (BR2_PACKAGE_XORG_SERVER is a later
# naming; kconfig silently drops assignments to unknown symbols).
BR2_PACKAGE_XORG7=y
# xinit and the driver menu hang off the server symbol in this layout.
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_NOUVEAU=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_MESA3D=y
# Kodi's visibility needs HAS_LIBEGL (+LIBGL): Mesa's EGL/GLES APIs are
# explicit options in this era. With classic DRI this is Mesa's
# egl-dri2 backend — whether Kodi's runtime prefers GLX or EGL on nv40
# is a Stage-1 observation, but the build gate needs these flags set.
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# The nv40 generation gets DRI through Mesa 17.1's NOUVEAU classic
# driver (there is no _NV40 symbol); this support is gone from
# Mesa >= 17.3 — pinned by this Buildroot's 17.1.5 (README §5).
BR2_PACKAGE_MESA3D_DRI_DRIVER_NOUVEAU=y

# ---- Media: Kodi 17 + CrystalHD userspace (removed in Kodi 18!) ----
# Kodi is visible only once python2 carries .py modules (its own gate
# comment): BR2_PACKAGE_PYTHON is this era's python2 symbol, and the
# era default installs .pyc ONLY — which the gate rejects, so the
# .py+.pyc choice is explicit. Kodi 17 bundles its Python runtime in
# core; this era has no separate BR2_PACKAGE_KODI_PYTHON symbol.
BR2_PACKAGE_PYTHON=y
BR2_PACKAGE_PYTHON_PY_PYC=y
BR2_PACKAGE_KODI=y
BR2_PACKAGE_CRYSTALHD=y

# ---- Utilities ----
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_HTOP=y
# target-side disk surgery: grow the data partition at install, GPT work for
# the stock boot-chain path once observed on hardware (ARCHITECTURE doc §4)
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y

# ---- Appliance client (ARCHITECTURE doc): Rust, built out-of-era against
# the Buildroot SDK — see tools/build-client.sh. Default-off until the
# binary exists; when it does, it takes over the tty1 kiosk slot. ----
# BR2_PACKAGE_ATV1_CLIENT=y

# ---- Bootloader: GRUB ia32 EFI (ATV1 firmware is 32-bit EFI) ----
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_EFI=y
# config embedded into grub image: board/grub-i386-efi.cfg

# ---- Rootfs & disk image ----
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_PACKAGE_HOST_GENIMAGE=y
